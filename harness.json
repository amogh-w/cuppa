{
  "_about": "Projects managed by the cuppa harness. root is absolute (this plugin is personal). kit.dir is where the project keeps its copy of the cuppa-ui kit; kit.files picks which kit files it uses. shared maps a file in shared/ to its place in the project. check is the project's quality-gate script. ui (optional) configures `lint`: sources are the project's own markup, script and stylesheet files (never the vendored kit or generated css), icons is its icons.txt, prefix its storage-key prefix, legacyKeys old storage keys kept only so they can be migrated or removed, themeRef the file that must load the kit's theme.js. regions maps a shared snippet to a project file that holds it between <!-- cuppa:NAME:start --> and <!-- cuppa:NAME:end --> comments.",
  "projects": [
    {
      "id": "openremote",
      "name": "OpenRemote",
      "root": "C:/Users/Amogh/Projects/OpenRemote",
      "kit": {
        "dir": "assets/ui/kit",
        "files": [
          "kit.css",
          "palette.css",
          "ui.js",
          "icons.mjs",
          "theme.js"
        ]
      },
      "shared": {
        "remote-client.js": "assets/ui/remote-client.js",
        "applog.rs": "src/applog.rs",
        "pairing.rs": "src/pairing.rs",
        "netguard.rs": "src/netguard.rs",
        "sleeptimer.rs": "src/sleeptimer.rs",
        "pairroutes.rs": "src/pairroutes.rs",
        "admin.rs": "src/admin.rs",
        "shell.rs": "src/shell.rs",
        "autostart.rs": "src/autostart.rs",
        "admin.html": "assets/ui/admin.html",
        "admin.js": "assets/ui/admin.js",
        "pair-client.js": "assets/ui/pair-client.js"
      },
      "check": "scripts/check.ps1",
      "ui": {
        "sources": [
          "assets/ui/head.html",
          "assets/ui/body.html",
          "assets/ui/app.js",
          "assets/ui/app.src.css",
          "assets/ui/admin.html",
          "assets/ui/admin.js",
          "assets/ui/pair-client.js"
        ],
        "icons": "assets/ui/kit/icons.txt",
        "prefix": "or",
        "themeRef": {
          "file": "build.rs",
          "needle": "kit/theme.js"
        }
      },
      "regions": {
        "pair-screen.html": {
          "file": "assets/ui/body.html",
          "marker": "pair-screen"
        }
      }
    },
    {
      "id": "kai-remote",
      "name": "Kai Remote",
      "root": "C:/Users/Amogh/Projects/Stremio-Kai/remote",
      "kit": {
        "dir": "web/ui",
        "files": [
          "kit.css",
          "palette.css",
          "ui.js",
          "icons.mjs",
          "theme.js"
        ]
      },
      "shared": {
        "remote-client.js": "web/remote-client.js",
        "applog.rs": "src/applog.rs",
        "pairing.rs": "src/pairing.rs",
        "netguard.rs": "src/netguard.rs",
        "sleeptimer.rs": "src/sleeptimer.rs",
        "pairroutes.rs": "src/pairroutes.rs",
        "admin.rs": "src/admin.rs",
        "shell.rs": "src/shell.rs",
        "autostart.rs": "src/autostart.rs",
        "admin.html": "web/admin.html",
        "admin.js": "web/admin.js",
        "pair-client.js": "web/pair-client.js"
      },
      "check": "scripts/check.ps1",
      "ui": {
        "sources": [
          "web/index.html",
          "web/admin.html",
          "web/admin.js",
          "web/pair-client.js"
        ],
        "icons": "web/ui/icons.txt",
        "prefix": "kai",
        "themeRef": {
